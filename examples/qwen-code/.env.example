# Copy this file to:  C:\Users\<you>\.qwen\.env   (Windows)
#                or:  ~/.qwen/.env                (macOS / Linux)
#
# 1) OPENAI_API_KEY  = YOUR chat.qwen.ai token (see README: "How to get your token")
# 2) OPENAI_BASE_URL = your proxy URL + /v1
#      - use your own Vercel deployment, e.g. https://your-proxy.vercel.app/v1
#      - or a shared instance if you have one
# 3) OPENAI_MODEL    = any model the proxy exposes (see GET /v1/models)

OPENAI_API_KEY=PASTE_YOUR_CHAT_QWEN_AI_TOKEN_HERE
OPENAI_BASE_URL=https://your-proxy.vercel.app/v1
OPENAI_MODEL=qwen3.7-max
