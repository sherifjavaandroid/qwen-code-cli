# ============================================================
#  Qwen Free API proxy — server environment (all OPTIONAL)
# ============================================================
#
# You normally do NOT need to set anything here: each client
# request already carries its own chat.qwen.ai token in the
# "Authorization: Bearer <token>" header, and the proxy forwards
# that token upstream.
#
# Set QWEN_AUTHORIZATION only if you want the server to FORCE a
# single fixed token for every request (ignoring the client's).
# Useful for a private, single-user deployment.
#
# QWEN_AUTHORIZATION=your_chat_qwen_ai_token_here
